+function field(f, d) {
+  const v = d[f.k];
+  const box = inner => `<div class="f" style="${f.w===2?'grid-column:1/-1':''}">
+    <label>${f.l}${f.req?' *':''}</label>${inner}${f.h?`<small>${f.h}</small>`:''}</div>`;
+
+  switch (f.t) {
+    case 'text': return box(`<input data-fk="${f.k}" value="${esc(v)}">`);
+    case 'num':  return box(`<input type="number" data-fk="${f.k}" value="${v ?? 0}" step="${f.step||1}">`);
+    case 'area': return box(`<textarea rows="${f.rows||3}" data-fk="${f.k}">${esc(v)}</textarea>`);
+    case 'sel':  return box(`<select data-fk="${f.k}">${f.opts().map(([o,l])=>
+                   `<option value="${o}" ${String(o)===String(v??'')?'selected':''}>${l}</option>`).join('')}</select>`);
+    case 'bool': return `<div class="f" style="grid-column:1/-1">
+                   <label class="sw"><input type="checkbox" data-fk="${f.k}" ${v?'checked':''}> ${f.l}</label>
+                   ${f.h?`<small>${f.h}</small>`:''}</div>`;
+    case 'multi':return box(`<div class="chips">${f.opts().map(([o,l])=>
+                   `<label class="chipbox ${(v||[]).includes(o)?'on':''}">
+                     <input type="checkbox" data-multi="${f.k}" value="${o}" ${(v||[]).includes(o)?'checked':''}>${l}</label>`).join('')}</div>`);
+    case 'paras':return box(`<div>${(v||[]).map((p,i)=>`<div class="para">
+                     <textarea rows="3" data-para="${i}">${esc(p)}</textarea>
+                     <button class="icon" data-paradel="${i}" title="Törlés">✕</button></div>`).join('')}
+                   <button class="dash" data-paraadd="1">+ Bekezdés</button></div>`);
+  }
+  return '';
+}
+
+function editor() {
+  if (!editing) return '';
+  const { kind, id, draft } = editing, C = COLL[kind], isNew = id === null;
+  const missing = FIELDS[kind].filter(f => f.req &&
+    (draft[f.k] === '' || draft[f.k] == null || (Array.isArray(draft[f.k]) && !draft[f.k].length)));
+
+  let extra = '';
+  if (kind === 'kezelesek') {
+    const tot = (+draft.bufferBeforeMin||0) + (+draft.durationMin||0) + (+draft.bufferAfterMin||0);
+    extra = `<div class="note info">Egy foglalás <b>${tot} percet</b> foglal a naptárban,
+      ebből ${draft.durationMin||0} perc a kezelés.</div>`;
+  }
+  if (kind === 'berletek' && draft.serviceIds?.length) {
+    const top = Math.max(...draft.serviceIds.map(i => db.services.find(s=>s.id===i)?.priceGross || 0));
+    const full = top * (+draft.sessionCount || 0), save = full - (+draft.priceGross||0);
+    extra = `<div class="note ${save>0?'ok':'warn'}">Listaáron ${Ft(full)} lenne.
+      ${save>0 ? `A bérlet <b>${Ft(save)}</b> megtakarítás.`
+               : 'A bérlet ára nem kedvezőbb a listaárnál – ezt érdemes ellenőrizni.'}</div>`;
+  }
+
+  return `<div class="back" data-back><div class="modal">
+    <button class="x" data-close>✕</button>
+    <h2 class="dm">${isNew ? `Új ${C.one}` : `${C.one[0].toUpperCase()+C.one.slice(1)} szerkesztése`}</h2>
+    <p style="color:var(--muted);margin:0 0 20px">A mentés azonnal él a weboldalon.</p>
+    <div class="grid2">${FIELDS[kind].map(f=>field(f,draft)).join('')}</div>
+    ${extra}
+    ${missing.length ? `<div class="note warn">Kötelező még: ${missing.map(f=>f.l).join(', ')}</div>` : ''}
+    <div class="acts">
+      <button class="btn" data-save ${missing.length?'disabled':''}>Mentés</button>
+      <button class="btn out" data-close>Mégsem</button>
+    </div></div></div>`;
+}
