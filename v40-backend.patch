+// ===========================================================================
+//  Render + kötések
+// ===========================================================================
+function render() {
+  document.getElementById('nav').innerHTML = NAV.map(([g,items]) =>
+    `<div class="grp">${g}</div>` + items.map(([k,l]) =>
+      `<a href="#" data-v="${k}" class="${k===view?'on':''}">${l}</a>`).join('')).join('');
+  document.getElementById('main').innerHTML = (VIEWS[view] || vKezelesek)();
+  document.getElementById('overlay').innerHTML = editor() + confirmBox() +
+    (toast ? `<div class="toast">${toast}</div>` : '');
+  bind();
+}
+
+function flash(m) { toast = m; render(); setTimeout(()=>{ toast = null; render(); }, 2600); }
+
+/** Újrarender után visszaadja a fókuszt és a kurzort – enélkül minden leütés elveszne. */
+function keepCaret(sel, pos) {
+  render();
+  const el = document.querySelector(sel);
+  if (el) { el.focus(); try { el.setSelectionRange(pos, pos); } catch {} }
+}
+
+function bind() {
+  const on = (s,e,f) => document.querySelectorAll(s).forEach(el => el.addEventListener(e,f));
+  const D = () => editing.draft;
+
+  on('[data-v]','click', e => { e.preventDefault(); view = e.currentTarget.dataset.v; q = ''; render(); });
+  on('#q','input', e => { const pos = e.target.selectionStart; q = e.target.value; keepCaret('#q', pos); });
+
+  on('[data-new]','click', e => {
+    const k = e.currentTarget.dataset.new;
+    editing = { kind:k, id:null, draft:BLANK[k]() }; render();
+  });
+  on('[data-edit]','click', e => {
+    const [k,id] = e.currentTarget.dataset.edit.split(':');
+    editing = { kind:k, id:+id, draft:JSON.parse(JSON.stringify(COLL[k].arr().find(x=>x.id===+id))) };
+    render();
+  });
+  on('[data-del]','click', e => {
+    const [k,id] = e.currentTarget.dataset.del.split(':');
+    confirming = { kind:k, id:+id }; render();
+  });
+  on('[data-restore]','click', e => {
+    const [k,id] = e.currentTarget.dataset.restore.split(':');
+    COLL[k].arr().find(x=>x.id===+id).archivedAt = null;
+    flash('Visszakapcsolva – újra megjelenik a weboldalon.');
+  });
+  on('[data-doarch]','click', () => {
+    const { kind, id } = confirming, arr = COLL[kind].arr();
+    const row = arr.find(x=>x.id===id);
+    if (usedBy(COLL[kind].kind, id) > 0) {
+      row.archivedAt = new Date().toISOString();
+      confirming = null; flash('Archiválva – eltűnt a weboldalról, az előzmény megmaradt.');
+    } else {
+      arr.splice(arr.indexOf(row), 1);
+      confirming = null; flash('Véglegesen törölve.');
+    }
+  });
+  on('[data-close]','click', () => { editing = null; confirming = null; render(); });
+  on('[data-back]','click', e => {
+    if (e.target === e.currentTarget) { editing = null; confirming = null; render(); }
+  });
+
+  // --- űrlapmezők ---
+  on('[data-fk]','input', e => {
+    const k = e.target.dataset.fk;
+    const num = e.target.type === 'number' || k === 'vatRate';
+    D()[k] = e.target.type === 'checkbox' ? e.target.checked : num ? +e.target.value : e.target.value;
+    if ((k === 'title' || k === 'name') && editing.id === null) D().slug = slugify(D()[k]);
+    keepCaret(`[data-fk="${k}"]`, e.target.selectionStart ?? 0);
+  });
+  on('[data-multi]','change', e => {
+    const k = e.target.dataset.multi, v = +e.target.value, cur = D()[k] || [];
+    D()[k] = e.target.checked ? [...cur, v] : cur.filter(x => x !== v);
+    render();
+  });
+  on('[data-para]','input', e => { D().longDesc[+e.target.dataset.para] = e.target.value; });
+  on('[data-paradel]','click', e => { D().longDesc.splice(+e.currentTarget.dataset.paradel,1); render(); });
+  on('[data-paraadd]','click', () => { D().longDesc.push(''); render(); });
+
+  on('[data-save]','click', () => {
+    const { kind, id, draft } = editing, arr = COLL[kind].arr();
+    if (id === null) { draft.id = ++uid; arr.push(draft); flash(`Létrehozva: ${draft.title || draft.name}`); }
+    else { Object.assign(arr.find(x=>x.id===id), draft); flash('Mentve.'); }
+    editing = null;
+  });
+
+  // --- beosztás ---
+  const wire = (tag, map) => {
+    on(`[data-${tag}]`,'change', e => {
+      const [iso,bi,edge] = e.target.dataset[tag].split(':');
+      map()[+iso][+bi][edge === 's' ? 0 : 1] = MIN(e.target.value); render();
+    });
+    on(`[data-${tag}d]`,'click', e => {
+      const [iso,bi] = e.currentTarget.dataset[tag+'d'].split(':').map(Number);
+      map()[iso].splice(bi,1); render();
+    });
+    on(`[data-${tag}a]`,'click', e => {
+      const iso = +e.currentTarget.dataset[tag+'a'];
+      (map()[iso] = map()[iso] || []).push([540,1020]); render();
+    });
+  };
+  wire('ch', () => db.clinicHours);
+  wire('ph', () => (db.practitioners.find(x=>x.id===activePract) || db.practitioners[0]).hours);
+  const pp = document.getElementById('pp');
+  if (pp) pp.onchange = () => { activePract = +pp.value; render(); };
+
+  // --- szövegek / SEO / beállítások ---
+  on('[data-cp]','click', e => { contentPage = e.currentTarget.dataset.cp; render(); });
+  on('[data-ck]','input', e => { db.content.find(c=>c.key===e.target.dataset.ck).value = e.target.value; });
+  on('[data-csave]','click', () => flash('Szövegek mentve – a weboldalon azonnal élnek.'));
+
+  on('[data-seo]','input', e => {
+    const [i,f] = e.target.dataset.seo.split(':');
+    db.seo[+i][f] = e.target.value;
+    keepCaret(`[data-seo="${i}:${f}"]`, e.target.selectionStart ?? 0);
+  });
+  on('[data-seob]','change', e => { db.seo[+e.target.dataset.seob].noindex = e.target.checked; render(); });
+  on('[data-seosave]','click', () => flash('SEO mentve.'));
+
+  on('[data-setn]','input',  e => { db.settings[e.target.dataset.setn] = +e.target.value; });
+  on('[data-sett]','input',  e => { db.settings[e.target.dataset.sett] = e.target.value; });
+  on('[data-setb]','change', e => { db.settings[e.target.dataset.setb] = e.target.checked; render(); });
+  on('[data-ssave]','click', () => flash('Beállítások mentve.'));
+}
+
+document.addEventListener('keydown', e => {
+  if (e.key === 'Escape' && (editing || confirming)) { editing = null; confirming = null; render(); }
+});
+render();
+</script>
