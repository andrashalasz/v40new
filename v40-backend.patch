-<script>
-// ---------------------------------------------------------------------------
-//  Állapot – éles rendszerben ez a ClinicSettings / ClinicHours / WorkingHours
-//  / Service / Room táblákból jön.
-// ---------------------------------------------------------------------------
-const DAYS = ['Hétfő','Kedd','Szerda','Csütörtök','Péntek','Szombat','Vasárnap'];
-
-const state = {
-  settings: {
-    slotGranularityMin: 15,
-    holdMinutes: 15,
-    defaultMinLeadTimeHours: 24,
-    defaultMaxLeadTimeDays: 90,
-    freeCancellationHours: 24,
-    reminderHoursBefore: 24,
-    requireBuffersInsideHours: false,
-    allowOnlineCancellation: true,
-    allowOnlineReschedule: true,
-  },
-  clinicHours: { 1:[[540,1140]], 2:[[540,1140]], 3:[[540,1140]], 4:[[540,1140]], 5:[[540,1020]], 6:[[600,840]], 7:[] },
-  rooms: [
-    { id:1, name:'Infúziós szoba A' },
-    { id:2, name:'Infúziós szoba B' },
-    { id:3, name:'Vizsgáló' },
-  ],
-  practitioners: [
-    { id:1, name:'Dr. Vértes Anna', hours:{1:[[540,780],[840,1140]],2:[[540,1140]],3:[],4:[[540,1140]],5:[[540,1020]],6:[],7:[]}, timeOff:[] },
-    { id:2, name:'Dr. Szabó Gábor', hours:{1:[[600,1020]],2:[],3:[[600,1140]],4:[[600,1020]],5:[[600,1020]],6:[[600,840]],7:[]}, timeOff:[] },
-  ],
-  services: [
-    { id:1, title:'NAD+ Energy',        durationMin:90,  bufferBefore:10, bufferAfter:15, leadH:24, maxD:90, online:true,  roomIds:[1,2] },
-    { id:2, title:'Radiance bőrfiatalítás', durationMin:60, bufferBefore:0, bufferAfter:15, leadH:24, maxD:60, online:true,  roomIds:[3] },
-    { id:3, title:'CardioFit felmérés', durationMin:45,  bufferBefore:0,  bufferAfter:10, leadH:48, maxD:90, online:true,  roomIds:[3] },
-    { id:4, title:'Signature konzultáció', durationMin:30, bufferBefore:0, bufferAfter:5, leadH:12, maxD:90, online:true, roomIds:[] },
-  ],
-};
-
-// ---------------------------------------------------------------------------
-//  Idő-segédek (a nap perceiben – az előnézet egy napra szól)
-// ---------------------------------------------------------------------------
-const toHM = m => `${String(Math.floor(m/60)).padStart(2,'0')}:${String(m%60).padStart(2,'0')}`;
-const toMin = s => { const [h,m] = s.split(':').map(Number); return h*60+m; };
-
-function intersect(a, b) {
-  const out = [];
-  for (const [s1,e1] of a) for (const [s2,e2] of b) {
-    const s = Math.max(s1,s2), e = Math.min(e1,e2);
-    if (e > s) out.push([s,e]);
-  }
-  return out.sort((x,y)=>x[0]-y[0]);
-}
-function subtract(blocks, cuts) {
-  let out = blocks.map(b=>[...b]);
-  for (const [cs,ce] of cuts) {
-    const next = [];
-    for (const [s,e] of out) {
-      if (ce <= s || cs >= e) { next.push([s,e]); continue; }
-      if (cs > s) next.push([s,cs]);
-      if (ce < e) next.push([ce,e]);
-    }
-    out = next;
-  }
-  return out;
-}
-
-// ---------------------------------------------------------------------------
-//  Szabad idősávok – a szerveroldali motor egyszerűsített, egynapos mása
-// ---------------------------------------------------------------------------
-function computePreview() {
-  const svc = state.services.find(s => s.id === +document.getElementById('pvService').value);
-  const pr  = state.practitioners.find(p => p.id === +document.getElementById('pvPract').value);
-  const dateStr = document.getElementById('pvDate').value;
-  if (!svc || !pr || !dateStr) return null;
-
-  const d = new Date(dateStr + 'T12:00:00');
-  const iso = d.getDay() === 0 ? 7 : d.getDay();
-
-  const clinic = state.clinicHours[iso] || [];
-  const pract  = pr.hours[iso] || [];
-  const open   = subtract(intersect(clinic, pract), pr.timeOff.filter(t=>t.weekday===iso).map(t=>[t.start,t.end]));
-
-  const step = state.settings.slotGranularityMin;
-  const need = svc.durationMin;
-  const occupiedLen = svc.bufferBefore + svc.durationMin + svc.bufferAfter;
-
-  const slots = [];
-  for (const [ws,we] of open) {
-    for (let t = ws; t + need <= we; t += step) {
-      if (state.settings.requireBuffersInsideHours &&
-          (t - svc.bufferBefore < ws || t + need + svc.bufferAfter > we)) continue;
-      slots.push(t);
-    }
-  }
-
-  // Előjegyzési korlát: a mai naptól számított minimum
-  const today = new Date(); today.setHours(0,0,0,0);
-  const daysAhead = Math.round((new Date(dateStr+'T00:00:00') - today) / 86400000);
-  const leadDays = svc.leadH / 24;
-
-  const warnings = [];
-  if (!clinic.length)      warnings.push('Ezen a napon a rendelő zárva van.');
-  else if (!pract.length)  warnings.push(`${pr.name} ezen a napon nem rendel.`);
-  else if (!open.length)   warnings.push('A szakember beosztása nem fedi a rendelő nyitvatartását.');
-  else if (!slots.length)  warnings.push(`A kezelés ${need} perce nem fér bele egyetlen szabad sávba sem.`);
-
-  if (daysAhead < leadDays)
-    warnings.push(`Az előjegyzési korlát (${svc.leadH} óra) miatt ez a nap az ügyfélnek nem is jelenne meg.`);
-  if (daysAhead > svc.maxD)
-    warnings.push(`A naptár csak ${svc.maxD} napra előre nyitott – ez a nap még zárt.`);
-  if (!svc.roomIds.length)
-    warnings.push('Ehhez a kezeléshez nincs szoba hozzárendelve, tehát a párhuzamos kapacitás nincs korlátozva.');
-  if (!svc.online)
-    warnings.push('Ez a kezelés nem foglalható online.');
-
-  return { svc, pr, open, slots, occupiedLen, warnings, iso };
-}
