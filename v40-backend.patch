+import { PrismaClient } from '@prisma/client'
+
+// Fejlesztés közben a Nuxt HMR újratölti a modulokat. Globális gyorsítótár
+// nélkül minden újratöltés új kapcsolatkészletet nyitna, és a MySQL pár perc
