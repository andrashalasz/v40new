+    orderBy: [{ sortOrder: 'asc' }, { name: 'asc' }],
+    countRefs: async (id) => ({
+      count: await prisma.service.count({ where: { categoryId: id } }),
+      label: 'kezelés tartozik hozzá',
+    }),
+  },
+
+  practitioners: {
+    model: 'practitioner',
