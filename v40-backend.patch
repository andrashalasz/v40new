+function confirmBox() {
+  if (!confirming) return '';
+  const { kind, id } = confirming, C = COLL[kind];
+  const row = C.arr().find(x=>x.id===id), n = usedBy(C.kind, id);
+  return `<div class="back" data-back><div class="modal" style="max-width:520px">
+    <button class="x" data-close>✕</button>
+    <h2 class="dm">${esc(row.title || row.name)}</h2>
+    <p style="color:var(--muted);margin:4px 0 16px">Eltávolítás a weboldalról</p>
+    ${n > 0
+      ? `<div class="note warn">Ehhez a bejegyzéshez <b>${n} korábbi foglalás</b> tartozik, ezért véglegesen
+          nem törölhető: a foglalások és a kiállított számlák hivatkoznak rá, és elszakadna a nyomvonal.<br><br>
+          Helyette <b>archiválva</b> lesz. Az ügyfél számára ugyanaz történik: azonnal eltűnik a weboldalról
+          és a foglalható listákból. Csak az előzmény marad meg mögötte, és bármikor visszakapcsolható.</div>`
+      : `<div class="note ok">Ehhez a bejegyzéshez nem tartozik foglalás, tehát véglegesen törölhető.</div>`}
+    <div class="acts">
+      <button class="btn danger" data-doarch>${n>0 ? 'Archiválás' : 'Véglegesen törlöm'}</button>
+      <button class="btn out" data-close>Mégsem</button>
+    </div></div></div>`;
