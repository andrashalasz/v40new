DATABASE_URL=
NUXT_SESSION_PASSWORD=
# ---------------------------------------------------------------------------
#  Seed – az admin felhasználó adatai (a repóba NEM kerülhet be jelszó)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@v40vital.hu"
ADMIN_PASSWORD=""

# ---------------------------------------------------------------------------
#  Munkamenet (nuxt-auth-utils) – legalább 32 karakter
#  Generálás: openssl rand -base64 32
# ---------------------------------------------------------------------------
NUXT_SESSION_PASSWORD=""

# ---------------------------------------------------------------------------
#  Barion – bankkártyás fizetés
#  A POSKey a Barion fiókban, a Kereskedelmi elfogadóhely alatt található.
#  Először MINDIG a sandboxban (https://api.test.barion.com) tesztelj.
# ---------------------------------------------------------------------------
BARION_POS_KEY=""
BARION_BASE_URL="https://api.test.barion.com"
BARION_PAYEE=""
# A visszatérési és callback URL-ek a publikus domainre kell hogy mutassanak
PUBLIC_BASE_URL="http://localhost:3001"
# A cron endpointok védelme (HOLD-lejárat, emlékeztetők, fizetés-egyeztetés)
CRON_SECRET=""

# ---------------------------------------------------------------------------
#  Számlázás (Számlázz.hu vagy Billingo) – a NAV bejelentést a szolgáltató végzi
# ---------------------------------------------------------------------------
INVOICE_PROVIDER="SZAMLAZZHU"
INVOICE_API_KEY=""
# Számlázz.hu "Számla Agent" kulcs. Ha üres, a rendszer Mock számlát állít ki
# (nincs valós NAV-beküldés). A NAV Online Számla beküldést a Számlázz.hu
# automatikusan végzi, ha a fiók be van kötve a NAV-hoz.
SZAMLAZZHU_AGENT_KEY=""

# ---------------------------------------------------------------------------
#  E-mail küldés (visszaigazolás, emlékeztető, belépő link)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="V40 Vital <info@v40vital.hu>"

# ---------------------------------------------------------------------------
#  Stripe – kártya-biztosíték (SetupIntent) és no-show terhelés
#  Ha a STRIPE_SECRET_KEY üres, a rendszer a Mock providert használja: a teljes
#  folyamat végigvihető valódi kulcsok nélkül is (fejlesztés/teszt).
#  Először MINDIG a Stripe teszt-kulcsaival (sk_test_..., pk_test_...) dolgozz.
#  A webhook secretet a Stripe Dashboard / CLI adja: whsec_...
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
