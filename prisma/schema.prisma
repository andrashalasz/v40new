// =============================================================================
//  V40 Vital - adatmodell v2
//  Időpontfoglalás + bankkártyás fizetés + bérletkezelés
// =============================================================================
//  KONVENCIÓK
//  - Minden DateTime UTC-ben tárolódik. A Europe/Budapest konverzió az
//    alkalmazás rétegben történik (nyári időszámítás miatt kötelező).
//  - Napon belüli időpontok (nyitvatartás) éjfél óta eltelt PERCBEN, Int-ként.
//    Így nincs időzóna-csapda az ismétlődő beosztásoknál.
//  - Pénzösszegek: Int, bruttó, HUF (a forintnak nincs váltópénze).
//    A nettó/áfa a vatRate-ből számolódik, nem tároljuk redundánsan.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================ FELHASZNÁLÓK ===================================

enum Role {
  USER
  DOCTOR // csak szakvéleményt ír a hozzárendelt pácienseinek
  STAFF
  ADMIN
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  role            Role      @default(USER)

  lastName  String?
  firstName String?
  phone     String?
  birthDate DateTime? // páciens születési dátuma (szakvélemény dokumentum-kódjához)
  isActive  Boolean   @default(true) // deaktiválás: nem tud belépni

  // GDPR
  marketingConsentAt DateTime?
  privacyAcceptedAt  DateTime?
  anonymizedAt       DateTime? // törlési kérés: adat anonimizálva, számla marad

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  orders        Order[]
  passes        CustomerPass[]
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]
  loginTokens    LoginToken[]
  mobileSessions MobileSession[]

  healthConsents HealthConsent[]
  healthMetrics  HealthDailyMetric[]
  healthSync     HealthSyncState[]

  medicalOpinions  MedicalOpinion[] @relation("PatientOpinions")
  authoredOpinions MedicalOpinion[] @relation("AuthoredOpinions")
  questionnaires   QuestionnaireResponse[]

  patientLinks      PatientDoctor[]   @relation("PatientLinks") // páciensként: kik az orvosai
  doctorLinks       PatientDoctor[]   @relation("DoctorLinks") // orvosként: kik a pácienei
  documents         PatientDocument[] @relation("PatientDocuments") // páciens saját dokumentumai
  uploadedDocuments PatientDocument[] @relation("UploadedDocuments")

  @@index([createdAt])
}

// Kitöltött kérdőív (pl. mikrobiom felmérés). Bejelentkezett pácienshez kötve,
// vagy vendégként név/e-mail megadásával. A staff/hozzárendelt orvos látja.
model QuestionnaireResponse {
  id        Int      @id @default(autoincrement())
  type      String // "mikrobiom"
  userId    Int?
  name      String?
  email     String?
  answers   Json
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([type, createdAt])
  @@index([userId])
}

// Orvos–páciens hozzárendelés. A hozzárendelt orvos látja a páciens
// történetét és dokumentumait, és szakvéleményt írhat neki.
model PatientDoctor {
  id        Int      @id @default(autoincrement())
  patientId Int
  doctorId  Int
  createdAt DateTime @default(now())

  patient User @relation("PatientLinks", fields: [patientId], references: [id], onDelete: Cascade)
  doctor  User @relation("DoctorLinks", fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@index([doctorId])
}

// A páciens által (vagy nevében) feltöltött dokumentum. A páciens a fiókjában
// tölti fel; a hozzárendelt orvos és a staff látja.
model PatientDocument {
  id           Int    @id @default(autoincrement())
  userId       Int // páciens
  uploadedById Int? // ki töltötte fel (páciens vagy staff)

  fileName String
  fileUrl  String
  mimeType String?
  size     Int?
  note     String? @db.Text

  createdAt DateTime @default(now())

  user       User  @relation("PatientDocuments", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("UploadedDocuments", fields: [uploadedById], references: [id])

  @@index([userId, createdAt])
}

// Szakvélemény / páciens-dokumentáció. Egy regisztrált pácienshez a staff
// szakvéleményt ír, ami megjelenik az ügyfél fiókjában és e-mailben is kimegy.
// A dokumentum-kód a páciens születési évéből és a dokumentum dátumából áll.
model MedicalOpinion {
  id           Int    @id @default(autoincrement())
  documentCode String @unique // pl. "1985-20260817-A1B2"

  userId        Int // páciens
  authorId      Int? // staff, aki írta
  appointmentId Int? // kapcsolódó kezelés (opcionális)

  title String
  body  String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User         @relation("PatientOpinions", fields: [userId], references: [id])
  author      User?        @relation("AuthoredOpinions", fields: [authorId], references: [id])
  appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([userId, createdAt])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique // csak hash, soha nyers token
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======================= SZOLGÁLTATÁSOK / KEZELÉSEK ==========================

model ServiceCategory {
  id        Int    @id @default(autoincrement())
  slug      String @unique
  name      String
  sortOrder Int    @default(0)

  /// Ikon a nyitóoldali kártyán
  iconUrl String?
  /// Illusztráció a felugró ablak tetején (opcionális)
  heroImage String?
  /// A kártyán megjelenő rövid szöveg
  shortDesc String? @db.Text
  /// A felugró ablak teljes leírása (bekezdésekre bontva)
  longDesc  Json?
  isActive  Boolean @default(true)

  metaTitle       String?
  metaDescription String? @db.Text
  archivedAt      DateTime? // soft-delete a generikus admin CRUD-hoz

  services Service[]
}

model Service {
  id    Int    @id @default(autoincrement())
  slug  String @unique // ELTÉR a v1-től: tárolt slug, nem a címből generált,
  title String @unique // így a cím átírása nem törli az URL-t és a SEO-t
  lead  String? @db.Text
  desc  String  @db.Text

  categoryId Int?
  gender     String @default("Mindenki") // Mindenki | Férfi | Női

  // --- árazás ---
  priceGross      Int // bruttó HUF
  vatRate         Int     @default(0) // 0 = adómentes egészségügyi szolg., 27 = esztétikai
  vatExemptReason String? // pl. "TAM - Áfa tv. 85. § (1) c)"

  // --- időzítés (percben) ---
  durationMin      Int
  bufferBeforeMin  Int @default(0)
  bufferAfterMin   Int @default(0) // takarítás / előkészítés

  // --- foglalhatóság ---
  isActive         Boolean @default(true)
  isBookableOnline Boolean @default(true) // pl. konzultáció után elérhető kezelések
  requiresDeposit  Boolean @default(false)
  depositGross     Int     @default(0) // ha csak előleget kérünk online
  minLeadTimeHours Int     @default(24) // ennyivel előbb kell foglalni
  maxLeadTimeDays  Int     @default(90) // ennyivel előre nyitott a naptár

  picUrl    String?
  sortOrder Int     @default(0)

  // --- SEO ---
  metaTitle       String?
  metaDescription String? @db.Text
  ogImageUrl      String?
  noindex         Boolean @default(false)

  /// Nem törlünk: a régi foglalásoknak és számláknak hivatkozniuk kell rá
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category      ServiceCategory?      @relation(fields: [categoryId], references: [id])
  practitioners ServicePractitioner[]
  rooms         ServiceRoom[]
  passTemplates PassTemplateService[]
  appointments  Appointment[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([isActive, isBookableOnline])
}

// ============================== SZAKEMBEREK ==================================

model Practitioner {
  id       Int     @id @default(autoincrement())
  slug     String  @unique
  name     String  @unique
  titles   String? // "Dr.", "PhD" stb.
  category String?
  desc     String  @db.Text
  picUrl   String?
  isActive Boolean @default(true)

  metaTitle       String?
  metaDescription String? @db.Text

  /// Nem törlünk, archiválunk – lásd Service.archivedAt
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services     ServicePractitioner[]
  workingHours WorkingHours[]
  timeOff      TimeOff[]
  appointments Appointment[]
}

// Melyik szakember melyik kezelést végzi (és opcionálisan más időtartammal)
model ServicePractitioner {
  serviceId      Int
  practitionerId Int
  durationMin    Int? // override, ha eltér a szolgáltatás alapértékétől

  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@id([serviceId, practitionerId])
}

// Ismétlődő heti rendelési idő
model WorkingHours {
  id             Int @id @default(autoincrement())
  practitionerId Int
  weekday        Int // 1 = hétfő ... 7 = vasárnap (ISO)
  startMinute    Int // 540 = 09:00
  endMinute      Int // 1020 = 17:00

  validFrom DateTime?
  validTo   DateTime?

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId, weekday])
}

// Szabadság, betegség, egyedi zárás
model TimeOff {
  id             Int      @id @default(autoincrement())
  practitionerId Int
  startsAt       DateTime
  endsAt         DateTime
  reason         String?

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId, startsAt, endsAt])
}

// Egész rendelőre érvényes zárás (ünnepnap), szakember nélkül
model ClinicClosure {
  id       Int      @id @default(autoincrement())
  startsAt DateTime
  endsAt   DateTime
  reason   String?

  @@index([startsAt, endsAt])
}

// =============================== FOGLALÁS ====================================

enum AppointmentStatus {
  HOLD // ideiglenes zárolás fizetés közben (lejár, ha nem fizet)
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum SettlementType {
  ONLINE_CARD
  PASS // bérletből levonva
  ON_SITE // helyszíni fizetés
  DEPOSIT_ONLY // online előleg + helyszíni maradék
}

model Appointment {
  id        Int    @id @default(autoincrement())
  publicRef String @unique // ügyfélnek mutatott azonosító, pl. "V40-8FQ2LM"

  userId         Int
  serviceId      Int
  practitionerId Int
  roomId         Int?

  startsAt DateTime
  endsAt   DateTime // szolgáltatás hossza; a puffer NEM része, külön számoljuk

  status     AppointmentStatus @default(HOLD)
  settlement SettlementType
  holdUntil  DateTime? // HOLD státusz lejárata (jellemzően +15 perc)

  // DB-szintű védelem a dupla foglalás ellen: "practitionerId:ISO-időpont".
  // Lemondáskor NULL-ra állítjuk -> a MySQL több NULL-t megenged egy unique
  // indexben, tehát a felszabadult idősáv azonnal újra foglalható. (Egy sima
  // @@unique([practitionerId, startsAt]) itt hibás lenne: örökre blokkolná a
  // lemondott idősávot.) Az átlapolódás-vizsgálat emellett tranzakcióban fut.
  slotLock String? @unique @db.VarChar(64)

  /// Ugyanez a szobára: "roomId:ISO-időpont". Külön kulcs kell, mert a slotLock
  /// csak a szakembert védi – két különböző orvos ugyanabba a szobába tehetne
  /// foglalást azonos időpontra. A leggyakoribb versenyhelyzet épp az, hogy
  /// ketten a felkínált idősávra kattintanak egyszerre.
  roomSlotLock String? @unique @db.VarChar(64)

  priceGross Int // a foglalás pillanatában érvényes ár (nem hivatkozás!)
  vatRate    Int @default(0)

  customerNote String? @db.Text
  internalNote String? @db.Text

  cancelledAt        DateTime?
  cancelledByUserId  Int?
  cancellationReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id])
  service      Service         @relation(fields: [serviceId], references: [id])
  practitioner Practitioner    @relation(fields: [practitionerId], references: [id])
  room         Room?           @relation(fields: [roomId], references: [id])
  orderItems   OrderItem[]
  redemption   PassRedemption?
  guarantee    CardGuarantee?
  opinions     MedicalOpinion[]

  @@index([userId, startsAt])
  @@index([status, holdUntil])
  @@index([startsAt])
}

// ================================ BÉRLET =====================================

model PassTemplate {
  id    Int    @id @default(autoincrement())
  slug  String @unique
  title String @unique
  desc  String @db.Text

  priceGross Int
  vatRate    Int     @default(0)
  vatExemptReason String?

  sessionCount Int? // null = korlátlan alkalom az érvényességi időn belül
  validityDays Int // vásárlástól ennyi napig érvényes
  transferable Boolean @default(false)

  picUrl    String?
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  metaTitle       String?
  metaDescription String? @db.Text
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services   PassTemplateService[]
  passes     CustomerPass[]
  orderItems OrderItem[]
}

// A bérlet mely kezelésekre használható fel, és egy foglalás hány alkalmat visz
model PassTemplateService {
  passTemplateId  Int
  serviceId       Int
  sessionsPerUse  Int @default(1)

  passTemplate PassTemplate @relation(fields: [passTemplateId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([passTemplateId, serviceId])
}

enum PassStatus {
  PENDING_PAYMENT
  ACTIVE
  EXHAUSTED
  EXPIRED
  CANCELLED
  REFUNDED
}

model CustomerPass {
  id   Int    @id @default(autoincrement())
  code String @unique // helyszíni beváltáshoz is, pl. "V40-BER-3K9WPD"

  userId         Int
  passTemplateId Int
  orderId        Int?

  sessionsTotal     Int? // snapshot: a template később változhat
  sessionsRemaining Int?
  validFrom         DateTime
  validUntil        DateTime
  status            PassStatus @default(PENDING_PAYMENT)

  // snapshot az árról a számlázás és a részleges visszatérítés miatt
  purchasePriceGross Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user         User             @relation(fields: [userId], references: [id])
  passTemplate PassTemplate     @relation(fields: [passTemplateId], references: [id])
  order        Order?           @relation(fields: [orderId], references: [id])
  redemptions  PassRedemption[]

  @@index([userId, status])
  @@index([status, validUntil])
}

model PassRedemption {
  id             Int @id @default(autoincrement())
  customerPassId Int
  appointmentId  Int @unique // egy foglaláshoz egy levonás

  sessionsUsed Int      @default(1)
  redeemedAt   DateTime @default(now())

  // lemondás esetén visszaírás; a rekord auditban megmarad
  reversedAt     DateTime?
  reversalReason String?

  customerPass CustomerPass @relation(fields: [customerPassId], references: [id])
  appointment  Appointment  @relation(fields: [appointmentId], references: [id])

  @@index([customerPassId])
}

// ============================ RENDELÉS / FIZETÉS =============================

enum OrderStatus {
  NEW
  PENDING // fizetési oldalra átirányítva
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderItemKind {
  SERVICE // egy konkrét kezelés (foglaláshoz kötve)
  PASS // bérlet
  DEPOSIT // előleg egy kezelésre
}

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique // "V40-2026-000123"

  userId Int
  status OrderStatus @default(NEW)

  totalGross Int
  currency   String @default("HUF")

  // számlázási adatok snapshotja
  billingName       String?
  billingTaxNumber  String?
  billingCountry    String? @default("HU")
  billingZip        String?
  billingCity       String?
  billingAddress    String?

  termsAcceptedAt DateTime? // ÁSZF + elállási nyilatkozat elfogadása

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  items    OrderItem[]
  payments Payment[]
  invoices Invoice[]
  passes   CustomerPass[]

  @@index([userId, status])
  @@index([status, createdAt])
}

model OrderItem {
  id      Int           @id @default(autoincrement())
  orderId Int
  kind    OrderItemKind

  serviceId      Int?
  passTemplateId Int?
  appointmentId  Int?

  titleSnapshot   String // számlához: a vásárlás pillanatában érvényes név
  quantity        Int    @default(1)
  unitPriceGross  Int
  vatRate         Int    @default(0)
  vatExemptReason String?

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service      Service?      @relation(fields: [serviceId], references: [id])
  passTemplate PassTemplate? @relation(fields: [passTemplateId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])

  @@index([orderId])
}

enum PaymentProvider {
  BARION
  SIMPLEPAY
  STRIPE
  MOCK // fejlesztéshez
  CASH
  TRANSFER
  HEALTH_FUND // egészségpénztár
}

enum PaymentStatus {
  INITIATED
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

model Payment {
  id      Int @id @default(autoincrement())
  orderId Int

  provider          PaymentProvider
  providerPaymentId String? // Barion PaymentId / SimplePay transactionId
  status            PaymentStatus   @default(INITIATED)

  amountGross Int
  currency    String @default("HUF")

  // Idempotencia: ugyanaz a fizetési kísérlet kétszer ne induljon el
  idempotencyKey String @unique

  initiatedAt DateTime  @default(now())
  paidAt      DateTime?
  failReason  String?   @db.Text

  refundedGross Int @default(0)

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId, status])
}

// Minden bejövő callback/webhook nyersen naplózva.
// Enélkül egy fizetési vita eldönthetetlen, és az idempotencia sem garantálható.
model PaymentEvent {
  id        Int    @id @default(autoincrement())
  paymentId Int?

  provider          PaymentProvider
  providerEventId   String? // ha a provider ad ilyet -> duplikátum szűrés
  providerPaymentId String?
  eventType         String

  payload     Json
  signatureOk Boolean   @default(false)
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  processError String?  @db.Text

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, providerEventId])
  @@index([providerPaymentId])
  @@index([processedAt])
}

enum InvoiceProvider {
  SZAMLAZZHU
  BILLINGO
  MANUAL
}

model Invoice {
  id      Int @id @default(autoincrement())
  orderId Int

  provider          InvoiceProvider
  providerInvoiceId String?
  invoiceNumber     String?         @unique
  isStorno          Boolean         @default(false)
  stornoOfId        Int?

  totalGross Int
  pdfUrl     String?
  issuedAt   DateTime?
  navStatus  String? // NAV Online Számla visszajelzés a szolgáltatótól

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

// ============================== TARTALOM =====================================

model Blog {
  id     Int     @id @default(autoincrement())
  title  String
  slug   String  @unique
  picUrl String?
  lead   String? @db.LongText
  rows   Json?

  publishedAt DateTime?
  createdAt   DateTime  @default(now()) // v1-ben nem volt default -> mentési hiba
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

// ============================ NAPLÓ / ÉRTESÍTÉS ==============================

// Egészségügyi kontextus + pénzügyi műveletek: az auditálhatóság nem opcionális
model AuditLog {
  id       Int     @id @default(autoincrement())
  userId   Int? // aki a műveletet végezte (admin is)
  action   String // "appointment.cancel", "pass.redeem", "order.refund"
  entity   String
  entityId Int?
  meta     Json?
  ip       String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

enum NotificationChannel {
  EMAIL
  SMS
}

model NotificationLog {
  id        Int                 @id @default(autoincrement())
  channel   NotificationChannel
  template  String // "booking.confirmed", "booking.reminder24h"
  recipient String
  entity    String?
  entityId  Int?

  sentAt   DateTime?
  error    String?   @db.Text
  createdAt DateTime @default(now())

  @@index([template, entityId])
}

// ======================= BEÁLLÍTÁSOK / KAPACITÁS =============================

/// Egyetlen sor (id = 1). Globális foglalási és marketing beállítások.
model ClinicSettings {
  id Int @id @default(1)

  timezone           String @default("Europe/Budapest")
  slotGranularityMin Int    @default(15)
  holdMinutes        Int    @default(15)

  defaultMinLeadTimeHours Int @default(24)
  defaultMaxLeadTimeDays  Int @default(90)

  freeCancellationHours   Int     @default(24)
  allowOnlineCancellation Boolean @default(true)
  allowOnlineReschedule   Boolean @default(true)

  reminderHoursBefore Int     @default(24)
  smsRemindersEnabled Boolean @default(false)

  requireBuffersInsideHours Boolean @default(false)

  // --- fizetés / számlázás: adminból állítható, nem bekódolva ---
  currency             String  @default("HUF")
  onlinePaymentEnabled Boolean @default(true) // online bankkártyás fizetés felkínálása
  cardGuaranteeEnabled Boolean @default(true) // kártya-biztosíték bekérése foglaláskor
  noShowFeePercent     Int     @default(50) // no-show / késői lemondás díja a szolgáltatás árának %-ában
  invoiceAutoIssue     Boolean @default(true) // számla automatikus kiállítása fizetéskor

  // --- e-mail küldés (SMTP): adminból állítható, .env visszaeséssel ---
  smtpHost String?
  smtpPort Int     @default(587)
  smtpUser String?
  smtpPass String? // titok – adminból menthető, de kezeljük óvatosan
  mailFrom String? // "V40 Vital <info@v40vital.hu>"

  // --- SMS emlékeztető (Twilio) ---
  smsProvider    String  @default("NONE") // NONE | TWILIO
  smsFrom        String? // küldő szám (Twilio: +1..., vagy Alphanumeric Sender ID)
  twilioSid      String? // Account SID
  twilioToken    String? // Auth Token (titok)

  // --- marketing / analitika: az azonosítók is adminból állíthatók ---
  ga4MeasurementId String?
  gtmContainerId   String?
  metaPixelId      String?
  /// Sütibanner nélkül a pixelek nem tölthetnek be (GDPR)
  cookieBannerEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

/// A rendelő ismétlődő nyitvatartása: külső korlát a szakemberek beosztásán.
/// A tényleges foglalhatóság a kettő metszete.
model ClinicHours {
  id          Int @id @default(autoincrement())
  weekday     Int // ISO: 1 = hétfő ... 7 = vasárnap
  startMinute Int
  endMinute   Int

  @@index([weekday])
}

/// Szoba / gép / kezelőágy. Ez adja a párhuzamos kapacitást.
model Room {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  /// Nem törlünk, csak archiválunk: régi foglalásoknak meg kell maradnia
  archivedAt DateTime?

  services     ServiceRoom[]
  appointments Appointment[]
}

model ServiceRoom {
  serviceId Int
  roomId    Int

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  room    Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@id([serviceId, roomId])
}

// ============================ SZERKESZTHETŐ TARTALOM =========================
//  Minden frontend-szöveg innen jön. A kódban csak alapértelmezés van, amit
//  az itteni érték felülír -> a szerkesztés nem tud "kiürült" oldalt okozni.

enum ContentType {
  TEXT
  RICHTEXT
  IMAGE
  URL
  NUMBER
}

model ContentBlock {
  id Int @id @default(autoincrement())

  /// Gépi azonosító, pl. "home.hero.title"
  key    String
  locale String @default("hu")

  /// Az admin felület csoportosításához és kereséséhez
  page  String // "home", "kezelesek", "gyik", "footer" ...
  group String? // "hero", "why", "cta" ...
  label String // amit az admin lát: "Nyitóoldal – főcím"

  type  ContentType @default(TEXT)
  value String      @db.Text

  updatedAt DateTime @updatedAt
  updatedBy Int?

  @@unique([key, locale])
  @@index([page, group])
}

// ================================== SEO ======================================

/// Statikus útvonalak meta-adatai. A dinamikus oldalak (kezelés, bérlet, blog)
/// saját meta mezőket kapnak, mert a slug is náluk van.
model SeoMeta {
  id     Int    @id @default(autoincrement())
  path   String // "/", "/kezelesek", "/gyik"
  locale String @default("hu")

  title          String?
  description    String? @db.Text
  ogTitle        String?
  ogDescription  String? @db.Text
  ogImageUrl     String?
  canonicalUrl   String?
  noindex        Boolean @default(false)
  /// Strukturált adat (MedicalClinic, FAQPage, MedicalProcedure ...)
  jsonLd         Json?

  updatedAt DateTime @updatedAt

  @@unique([path, locale])
}

/// Slug-változáskor 301-es átirányítás. Enélkül minden átnevezés SEO-t veszít.
model Redirect {
  id         Int      @id @default(autoincrement())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
}

// ============================ MARKETING / GDPR ===============================

enum ConsentCategory {
  NECESSARY
  ANALYTICS
  MARKETING
}

/// A sütihozzájárulás bizonyítható naplózása. Egészségügyi oldalnál ez nem
/// formalitás: a marketing pixelek engedély nélküli betöltése jogsértés.
model ConsentLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  visitorId  String // anonim, süti alapú azonosító
  categories Json // { necessary:true, analytics:true, marketing:false }
  policyVersion String
  userAgent  String?  @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  @@index([visitorId])
  @@index([createdAt])
}

/// Hírlevél / marketing feliratkozás, dupla opt-innel.
model NewsletterSubscriber {
  id            Int       @id @default(autoincrement())
  email         String    @unique
  name          String?
  confirmTokenHash String? @unique
  confirmedAt   DateTime?
  unsubscribedAt DateTime?
  source        String? // "footer", "foglalas", "berlet"
  createdAt     DateTime  @default(now())
}

// ============================ BEJELENTKEZÉS ==================================

/// Jelszó nélküli belépés e-mailben küldött egyszer használatos linkkel.
/// Így a foglaláshoz nem kell jelszót kitalálni, de fiók mégis létrejön.
model LoginToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Mobilalkalmazás eszköz-munkamenet (iOS / Android).
///
/// A weboldal süti-alapú munkamenetet használ (nuxt-auth-utils), ez viszont a
/// natív appból nem működik. Az app helyette Bearer tokent küld:
///   - rövid életű HOZZÁFÉRÉSI token (aláírt, 15 perc, nincs adatbázisban),
///   - hosszú életű FRISSÍTŐ token (itt, hash-elve tárolva, visszavonható).
///
/// Miért hash-elve: ha az adatbázis kiszivárog, a tokenekkel akkor sem lehet
/// belépni – ugyanaz az elv, mint a LoginToken és a PasswordReset esetében.
///
/// A frissítő token minden használatkor CSERÉLŐDIK (rotáció). Ha egy már
/// felhasznált tokennel próbálkoznak, az lopott tokenre utal, ezért olyankor a
/// felhasználó ÖSSZES eszköz-munkamenetét érvénytelenítjük.
model MobileSession {
  id               Int       @id @default(autoincrement())
  userId           Int
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?

  platform   String? // "ios" | "android"
  deviceName String?
  appVersion String?
  pushToken  String? // Expo push token az értesítésekhez

  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushToken])
  @@index([expiresAt])
}

// ======================= EGÉSZSÉGÜGYI ADATOK (Health) =======================

/// A páciens hozzájárulása EGY adatkategóriához (Apple Health / Health Connect).
///
/// A GDPR 9. cikke szerint az egészségügyi adat különleges adat: kifejezett,
/// célhoz kötött hozzájárulás kell hozzá, és bármikor visszavonható. Ezért nem
/// egyetlen "engedélyezem" kapcsoló van, hanem kategóriánként külön – és a
/// visszavonás ténye is megmarad (`revokedAt`), nem töröljük a sort.
///
/// Miért fontos ez a store-oknak is: az Apple és a Google is adattípusonként
/// kéri az indoklást. Egy mindenre kiterjedő hozzáférés a leggyakoribb
/// elutasítási ok egészségügyi alkalmazásoknál.
model HealthConsent {
  id       Int    @id @default(autoincrement())
  userId   Int
  /// Kategória kulcsa – lásd server/health/catalog.ts (pl. "cardio", "sleep").
  category String

  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  /// Melyik készülékről adták – panasz esetén visszakövethető.
  platform String? // "ios" | "android"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@index([userId])
}

/// Egy mérés NAPI összesítése.
///
/// SZÁNDÉKOSAN nem nyers mintát tárolunk. Egyetlen felhasználó pulzusából egy
/// év alatt több százezer minta gyűlik; tízezer páciensnél ez milliárdos
/// nagyságrend, amit sem tárolni, sem kirajzolni nem érdemes. Az orvosnak a
/// napi átlag / szélsőértékek / összeg mondanak valamit, nem a másodpercenkénti
/// érték.
///
/// Mellékhaszna, hogy GDPR szempontból is helyesebb: kevesebb adatot kezelünk,
/// mint amennyi elérhető lenne (adattakarékosság, 5. cikk).
///
/// A `day` a RENDELŐ időzónája szerinti nap (Europe/Budapest), különben egy
/// esti mérés a következő nap alá csúszna.
model HealthDailyMetric {
  id     Int      @id @default(autoincrement())
  userId Int
  /// Mérés kulcsa – lásd server/health/catalog.ts (pl. "heartRate", "steps").
  metric String
  day    DateTime @db.Date

  /// Az összesítés módja a mérés természetétől függ: a lépés ÖSSZEADÓDIK, a
  /// pulzus ÁTLAGOLÓDIK. Melyik mezőt kell nézni, azt a katalógus mondja meg.
  sum   Float?
  avg   Float?
  min   Float?
  max   Float?
  /// Hány minta esik a napra – ebből látszik, mennyire megbízható az átlag.
  count Int    @default(0)

  /// Mértékegység a katalógusból átvéve (pl. "bpm", "kg"), a megjelenítéshez.
  unit String

  /// Honnan jött: "apple_health" | "health_connect".
  source String

  syncedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// A szinkron IDEMPOTENS: ugyanaz a nap és mérés újraküldve felülírja a
  /// korábbi értéket, nem duplikál. Az app nyugodtan újraküldheti az utolsó
  /// napokat, ha közben pótlólagos mérés érkezett az órából.
  @@unique([userId, metric, day])
  @@index([userId, day])
  @@index([userId, metric, day])
}

/// Meddig jutott a szinkron egy készüléken – hogy ne kelljen mindig mindent
/// újraküldeni, csak a változást.
model HealthSyncState {
  id       Int      @id @default(autoincrement())
  userId   Int
  platform String // "ios" | "android"

  /// Az utolsó SIKERESEN feldolgozott nap.
  lastSyncedDay DateTime? @db.Date
  lastSyncAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

// ============================ TÖBBNYELVŰSÉG =================================

/// Kezelt nyelvek. A `hu` az alap (isDefault); az admin újat vehet fel, és a
/// felvitelkor AI lefordítja a tartalmat első körben.
model Language {
  id        Int      @id @default(autoincrement())
  code      String   @unique // rövid kód: "hu", "en", "de"
  name      String // megjelenő név: "Magyar", "English", "Deutsch"
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

/// Fordítások minden fordítható mezőhöz. Az alap (magyar) érték az eredeti
/// táblákban marad; ide a többi nyelv kerül. Ha egy (entity,entityId,field,
/// locale) hármas nincs meg, a frontend az alap nyelvre esik vissza – így egy
/// hiányzó fordítás sosem eredményez üres oldalt.
model Translation {
  id          Int      @id @default(autoincrement())
  entity      String // "Service", "ServiceCategory", "PassTemplate", "Practitioner"
  entityId    Int
  field       String // "title", "desc", "name", "shortDesc", "longDesc", ...
  locale      String // "en", "de"
  value       String   @db.Text
  aiGenerated Boolean  @default(false) // AI-fordítás volt-e (kézzel felülírható)
  updatedAt   DateTime @updatedAt

  @@unique([entity, entityId, field, locale])
  @@index([locale])
  @@index([entity, entityId])
}

// ======================= KÁRTYA-BIZTOSÍTÉK (no-show) ========================

/// A foglaláshoz elmentett kártya biztosítékként (Stripe SetupIntent). A
/// kezelést nem ez fizeti (azt helyszínen/bérletből), de meg-nem-jelenés
/// esetén a rendelő terhelhet róla no-show díjat. A tényleges kártyaadatot
/// SOHA nem tároljuk – csak a szolgáltatói hivatkozásokat.
model CardGuarantee {
  id              Int                 @id @default(autoincrement())
  appointmentId   Int                 @unique
  provider        PaymentProvider     @default(STRIPE)
  customerRef     String? // szolgáltatói ügyfél-azonosító (Stripe customer)
  setupIntentId   String?             @unique // Stripe SetupIntent
  paymentMethodId String? // elmentett fizetési mód (kártya) hivatkozása
  status          CardGuaranteeStatus @default(PENDING)
  cardBrand       String?
  cardLast4       String?
  chargedPaymentId String? // ha no-show díjat vontunk, a Payment.providerPaymentId
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
}

enum CardGuaranteeStatus {
  PENDING // SetupIntent létrehozva, a kártya megadására várunk
  ACTIVE // kártya elmentve, biztosítékként él
  CHARGED // no-show díj levonva
  CANCELLED // biztosíték feloldva
  FAILED
}
