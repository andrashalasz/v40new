{
  "expo": {
    "name": "V40 Vital",
    "slug": "v40vital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "v40vital",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.v40vital.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "A V40 Vital a helyi hálózaton futó fejlesztői kiszolgálóhoz csatlakozik a teszteléshez.",
        "NSAppTransportSecurity": {
          "//": "CSAK a helyi hálózat titkosítatlan elérése, TESZTELÉSHEZ. Az iOS alapból minden HTTP-t tilt. A magánhálózati kivétel szűk: nem nyitja meg az internetes HTTP-forgalmat. Éles kiadás előtt (HTTPS-es szerverre állva) ez a blokk TÖRLENDŐ – az App Review a tág kivételekre magyarázatot kér.",
          "NSAllowsLocalNetworking": true
        }
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "hu.v40vital.app",
      "adaptiveIcon": {
        "backgroundColor": "#153131",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_FLOORS_CLIMBED",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_LEAN_BODY_MASS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#153131",
          "imageWidth": 220
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "A V40 Vital az alvási, mozgási, szív- és testösszetételi adataidat mutatja meg a kezelőorvosodnak, hogy a kezelésedet a valós állapotodhoz igazítsa. Bármikor visszavonhatod.",
          "NSHealthUpdateUsageDescription": "A V40 Vital nem módosítja és nem írja felül az Egészség alkalmazásban tárolt adataidat – kizárólag olvassa azokat, az általad engedélyezett körben.",
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "//": "A backend alapértelmezett címe. A TestFlight-os buildbe beleég, DE az appban (Belépés képernyő alján) futásidőben átírható – így egy változó LAN-cím miatt nem kell új build.",
      "apiBaseUrl": "http://10.61.10.230:3001",
      "router": {},
      "eas": {
        "projectId": "69bf8b2d-8a66-4d0d-af0f-14e91547fe8c"
      }
    },
    "owner": "andrew1977"
  }
}
