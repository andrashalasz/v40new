{
  "expo": {
    "name": "V40 Vital",
    "slug": "v40vital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "v40vital",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.v40vital.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "hu.v40vital.app",
      "adaptiveIcon": {
        "backgroundColor": "#153131",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": {
      "//": "A backend címe. Fejlesztéskor a gép LAN-címe kell, mert a szimulátorból/telefonról a localhost nem a Mac-et jelenti. Élesben a publikus domain.",
      "apiBaseUrl": "http://localhost:3001"
    }
  }
}
