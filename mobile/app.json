{
  "expo": {
    "name": "V40 Vital",
    "slug": "v40vital",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "v40vital",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "hu.v40vital.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "package": "hu.v40vital.app",
      "adaptiveIcon": {
        "backgroundColor": "#153131",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#153131",
          "imageWidth": 220
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "A V40 Vital az alvási, mozgási, szív- és testösszetételi adataidat mutatja meg a kezelőorvosodnak, hogy a kezelésedet a valós állapotodhoz igazítsa. Bármikor visszavonhatod.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ]
    ],
    "extra": {
      "//": "A backend címe. A TestFlight-os buildbe BELEÉG: megváltoztatásához új build kell. Fejlesztéskor írd át a géped LAN-címére (http://192.168.x.x:3001).",
      "apiBaseUrl": "https://v40.orc.hu"
    }
  }
}
