{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "//": "Fejlesztői build valódi telefonra – a HealthKit szimulátorban üres."
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "testflight": {
      "extends": "production",
      "ios": {
        "buildConfiguration": "Release"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "//": "Az Apple ID-t és a csapat-azonosítót az `eas submit` interaktívan is bekéri. Ha CI-ben futtatnád, App Store Connect API kulcsot használj, ne jelszót."
      }
    }
  }
}
