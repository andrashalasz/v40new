{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false },
      "android": { "buildType": "apk" }
    },
    "android-apk": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "testflight": {
      "extends": "production",
      "ios": { "buildConfiguration": "Release" }
    },
    "production": {
      "autoIncrement": true,
      "ios": { "buildConfiguration": "Release" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "production": {},
    "testflight": {}
  }
}
